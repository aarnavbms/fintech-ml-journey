class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int maxProfit=0;
        int minprice=prices[0];
        for(int i=0;i<prices.size();i++){
            int profit=prices[i]-minprice;
            if(profit>maxProfit){
                maxProfit=profit;
            }
            if(prices[i]<minprice){
                minprice=prices[i];
            }
        }
        return maxProfit;
    }
};

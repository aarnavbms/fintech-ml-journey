class Solution{
    public:
        bool containsDuplicate(vector <int>&nums){
            unordered_map<int,int>s;
            for(int i=0;i<nums.size();i++){
                if(s.find(nums[i])!=s.end()){
                    return true;
                }
                s[nums[i]]=1;
            }
            return false;
        }
};
